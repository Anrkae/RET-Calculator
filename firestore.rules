rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function currentUserDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function currentUserExists() {
      return isSignedIn() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function isAdmin() {
      return currentUserExists() && currentUserDoc().data.tag == 'adm';
    }

    function isOwnUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function validTag(tag) {
      return tag in ['cr', 'adm'];
    }

    function safeText(value, maxChars) {
      return value is string
        && value.size() <= maxChars
        && !value.matches('.*[<>].*');
    }

    function validContract(value) {
      return value is string
        && (value == '' || value.matches('^\\d{3}/\\d{9}$'));
    }

    function validDashboardPreferences(preferences) {
      return preferences == null || (
        preferences is map
        && preferences.keys().hasOnly([
          'autoOpenPipOnPageChange',
          'askObservationOnCancel',
          'showContractFieldOnCancel'
        ])
        && (!('autoOpenPipOnPageChange' in preferences) || preferences.autoOpenPipOnPageChange is bool)
        && (!('askObservationOnCancel' in preferences) || preferences.askObservationOnCancel is bool)
        && (!('showContractFieldOnCancel' in preferences) || preferences.showContractFieldOnCancel is bool)
      );
    }

    function validBotSettings(data) {
      return data.keys().hasOnly([
          'workerIntervalMs',
          'fallbackGroupId',
          'cancelamentoWebhookPath',
          'demandaWebhookPath',
          'wppconnectBaseUrl',
          'wppconnectSessionName',
          'wppconnectBearerToken',
          'n8nBaseUrl',
          'textTemplates',
          'updatedAt'
        ])
        && safeText(data.workerIntervalMs, 16)
        && safeText(data.fallbackGroupId, 128)
        && safeText(data.cancelamentoWebhookPath, 256)
        && safeText(data.demandaWebhookPath, 256)
        && safeText(data.wppconnectBaseUrl, 256)
        && safeText(data.wppconnectSessionName, 64)
        && safeText(data.wppconnectBearerToken, 512)
        && safeText(data.n8nBaseUrl, 256)
        && data.updatedAt is string
        && data.textTemplates is map
        && data.textTemplates.keys().hasOnly([
          'cancelamento',
          'demanda',
          'demandaEncaixeVt',
          'demandaRetirarPonto',
          'demandaSuspensao'
        ])
        && (!('cancelamento' in data.textTemplates) || safeText(data.textTemplates.cancelamento, 1500))
        && (!('demanda' in data.textTemplates) || safeText(data.textTemplates.demanda, 1500))
        && (!('demandaEncaixeVt' in data.textTemplates) || safeText(data.textTemplates.demandaEncaixeVt, 1500))
        && (!('demandaRetirarPonto' in data.textTemplates) || safeText(data.textTemplates.demandaRetirarPonto, 1500))
        && (!('demandaSuspensao' in data.textTemplates) || safeText(data.textTemplates.demandaSuspensao, 1500));
    }

    function validSupervisorGroup(data) {
      return data.keys().hasOnly([
          'supervisor',
          'groupId',
          'enabled',
          'notes',
          'updatedAt'
        ])
        && safeText(data.supervisor, 80)
        && safeText(data.groupId, 128)
        && data.enabled is bool
        && safeText(data.notes, 300)
        && data.updatedAt is string;
    }

    match /usuarios/{uid} {
      allow create: if isOwnUser(uid)
        && request.resource.data.keys().hasOnly([
          'uid',
          'matricula',
          'nome',
          'tag',
          'supervisor',
          'dashboardPreferences',
          'email',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && safeText(request.resource.data.matricula, 20)
        && safeText(request.resource.data.nome, 120)
        && request.resource.data.email is string
        && request.resource.data.tag == 'cr'
        && request.resource.data.supervisor is string
        && request.resource.data.supervisor == ''
        && validDashboardPreferences(request.resource.data.dashboardPreferences);

      allow get: if isOwnUser(uid) || isAdmin();
      allow list: if isAdmin();

      allow update: if (
          isOwnUser(uid)
          && request.resource.data.keys().hasOnly([
            'uid',
            'matricula',
            'nome',
            'tag',
            'supervisor',
            'dashboardPreferences',
            'email',
            'createdAt',
            'updatedAt'
          ])
          && resource.data.uid == request.resource.data.uid
          && resource.data.matricula == request.resource.data.matricula
          && resource.data.nome == request.resource.data.nome
          && resource.data.email == request.resource.data.email
          && resource.data.createdAt == request.resource.data.createdAt
          && resource.data.tag == request.resource.data.tag
          && resource.data.supervisor == request.resource.data.supervisor
          && validDashboardPreferences(request.resource.data.dashboardPreferences)
        ) || (
          isAdmin()
          && request.resource.data.keys().hasOnly([
            'uid',
            'matricula',
            'nome',
            'tag',
            'supervisor',
            'dashboardPreferences',
            'email',
            'createdAt',
            'updatedAt'
          ])
          && resource.data.uid == request.resource.data.uid
          && resource.data.matricula == request.resource.data.matricula
          && resource.data.nome == request.resource.data.nome
          && resource.data.email == request.resource.data.email
          && resource.data.createdAt == request.resource.data.createdAt
          && safeText(request.resource.data.supervisor, 80)
          && validTag(request.resource.data.tag)
          && validDashboardPreferences(request.resource.data.dashboardPreferences)
        );

      allow delete: if false;
    }

    match /loginIndex/{matricula} {
      allow get: if true;
      allow list: if false;

      allow create: if currentUserExists()
        && request.resource.data.keys().hasOnly(['uid', 'matricula', 'email', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.matricula == matricula
        && safeText(request.resource.data.matricula, 20)
        && request.resource.data.email == currentUserDoc().data.email;

      allow update, delete: if false;
    }

    match /registrosAtendimento/{registroId} {
      allow create: if currentUserExists()
        && request.resource.data.keys().hasOnly([
          'date',
          'time',
          'duration',
          'result',
          'reason',
          'contract',
          'observation',
          'timestamp',
          'operator',
          'operatorName',
          'supervisor',
          'cancelCountOfDay',
          'uid',
          'dayId',
          'whatsappSent'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.operator == currentUserDoc().data.matricula
        && safeText(request.resource.data.operatorName, 120)
        && safeText(request.resource.data.supervisor, 80)
        && safeText(request.resource.data.reason, 120)
        && safeText(request.resource.data.result, 40)
        && safeText(request.resource.data.duration, 20)
        && safeText(request.resource.data.time, 20)
        && validContract(request.resource.data.contract)
        && safeText(request.resource.data.observation, 500);

      allow read: if currentUserExists()
        && (resource.data.uid == request.auth.uid || isAdmin());

      allow update, delete: if false;
    }

    match /cancelamentoFila/{queueId} {
      allow create: if currentUserExists()
        && request.resource.data.keys().hasOnly([
          'uid',
          'operator',
          'operatorName',
          'supervisor',
          'cancelCountOfDay',
          'reason',
          'contract',
          'observation',
          'duration',
          'time',
          'dayId',
          'sourceTimestamp',
          'status',
          'attempts',
          'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.operator == currentUserDoc().data.matricula
        && safeText(request.resource.data.operatorName, 120)
        && safeText(request.resource.data.supervisor, 80)
        && safeText(request.resource.data.reason, 120)
        && validContract(request.resource.data.contract)
        && safeText(request.resource.data.observation, 500)
        && safeText(request.resource.data.duration, 20)
        && safeText(request.resource.data.time, 20)
        && request.resource.data.status == 'pending';

      allow read, delete: if isAdmin();
      allow update: if false;
    }

    match /demandasFila/{queueId} {
      allow create: if currentUserExists()
        && request.resource.data.keys().hasOnly([
          'uid',
          'operator',
          'operatorName',
          'supervisor',
          'demandType',
          'contract',
          'date',
          'startHour',
          'endHour',
          'area',
          'classe',
          'point',
          'suspensionItems',
          'message',
          'status',
          'attempts',
          'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.operator == currentUserDoc().data.matricula
        && safeText(request.resource.data.operatorName, 120)
        && safeText(request.resource.data.supervisor, 80)
        && safeText(request.resource.data.demandType, 40)
        && validContract(request.resource.data.contract)
        && safeText(request.resource.data.date, 20)
        && safeText(request.resource.data.startHour, 10)
        && safeText(request.resource.data.endHour, 10)
        && safeText(request.resource.data.area, 80)
        && safeText(request.resource.data.classe, 80)
        && safeText(request.resource.data.point, 10)
        && request.resource.data.suspensionItems is list
        && request.resource.data.suspensionItems.size() <= 5
        && request.resource.data.suspensionItems.hasOnly(['TV', 'Virtua', 'Fone'])
        && safeText(request.resource.data.message, 1000)
        && request.resource.data.status == 'pending';

      allow read, delete: if isAdmin();
      allow update: if false;
    }

    match /solicitacoesAcesso/{requestId} {
      allow create: if currentUserExists()
        && request.resource.data.keys().hasOnly([
          'uid',
          'matricula',
          'nome',
          'email',
          'requestedAt',
          'notificationStatus',
          'decisionStatus',
          'notificationAttempts',
          'notifiedAt',
          'reviewedAt',
          'reviewedBy',
          'reviewNotes'
        ])
        && request.resource.data.uid == request.auth.uid
        && safeText(request.resource.data.matricula, 20)
        && safeText(request.resource.data.nome, 120)
        && request.resource.data.email is string
        && request.resource.data.notificationStatus == 'pending'
        && request.resource.data.decisionStatus == 'pending'
        && request.resource.data.notificationAttempts == 0
        && request.resource.data.notifiedAt == null
        && request.resource.data.reviewedAt == null
        && request.resource.data.reviewedBy == ''
        && request.resource.data.reviewNotes == '';

      allow get: if currentUserExists() && resource.data.uid == request.auth.uid;
      allow list: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /configuracoesBot/{docId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && validBotSettings(request.resource.data);
      allow delete: if false;
    }

    match /supervisorGrupos/{docId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && validSupervisorGroup(request.resource.data);
      allow delete: if isAdmin();
    }

    match /atendimentos/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function hasValidAtendimentoSchema() {
      return request.resource.data.keys().hasOnly([
        'date',
        'time',
        'duration',
        'result',
        'reason',
        'timestamp',
        'operator',
        'cancelCountOfDay',
        'dayId',
        'whatsappSent'
      ])
      && request.resource.data.date is string
      && request.resource.data.time is string
      && request.resource.data.duration is string
      && request.resource.data.result is string
      && request.resource.data.reason is string
      && request.resource.data.timestamp is number
      && request.resource.data.operator is string
      && request.resource.data.dayId is string
      && request.resource.data.whatsappSent is bool
      && (
        !('cancelCountOfDay' in request.resource.data)
        || request.resource.data.cancelCountOfDay is number
      );
    }

    match /registrosAtendimento/{docId} {
      allow create: if hasValidAtendimentoSchema();
      allow read: if true;
      allow update, delete: if false;
    }

    match /atendimentos/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

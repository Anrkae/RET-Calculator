rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function currentUserDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function currentUserExists() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function isAdmin() {
      return currentUserExists()
        && currentUserDoc().data.tag == "adm";
    }

    function isOwnUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function validTag(tag) {
      return tag == "cr" || tag == "adm";
    }

    function validUserCreate(uid) {
      return request.resource.data.keys().hasOnly([
          "uid",
          "matricula",
          "nome",
          "tag",
          "email",
          "createdAt"
        ])
        && request.resource.data.uid == uid
        && request.resource.data.matricula is string
        && request.resource.data.matricula.size() > 0
        && request.resource.data.nome is string
        && request.resource.data.nome.size() > 0
        && request.resource.data.tag == "cr"
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt is string;
    }

    function validUserTagUpdate() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly(["tag", "updatedAt"])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.matricula == resource.data.matricula
        && request.resource.data.nome == resource.data.nome
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && validTag(request.resource.data.tag)
        && request.resource.data.updatedAt is string;
    }

    function validRegistroCreate() {
      let profile = currentUserDoc().data;

      return request.resource.data.keys().hasOnly([
          "date",
          "time",
          "duration",
          "result",
          "reason",
          "timestamp",
          "operator",
          "operatorName",
          "operatorTag",
          "cancelCountOfDay",
          "uid",
          "dayId",
          "whatsappSent"
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.operator == profile.matricula
        && request.resource.data.operatorName == profile.nome
        && request.resource.data.operatorTag == profile.tag
        && request.resource.data.dayId is string
        && request.resource.data.date is string
        && request.resource.data.time is string
        && request.resource.data.duration is string
        && request.resource.data.result is string
        && request.resource.data.reason is string
        && request.resource.data.timestamp is int
        && request.resource.data.cancelCountOfDay is int
        && request.resource.data.whatsappSent is bool;
    }

    match /usuarios/{uid} {
      allow create: if isOwnUser(uid) && validUserCreate(uid);
      allow read: if isOwnUser(uid) || isAdmin();
      allow update: if isAdmin() && validUserTagUpdate();
      allow delete: if false;
    }

    match /registrosAtendimento/{registroId} {
      allow create: if currentUserExists() && validRegistroCreate();
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update, delete: if false;
    }

    match /atendimentos/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

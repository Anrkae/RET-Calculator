rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function currentUserDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function currentUserExists() {
      return isSignedIn() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function isAdmin() {
      return currentUserExists() && currentUserDoc().data.tag == 'adm';
    }

    function currentUserSupervisor() {
      return currentUserDoc().data.supervisor is string
        ? currentUserDoc().data.supervisor
        : '';
    }

    function isOwnUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function validTag(tag) {
      return tag in ['cr', 'adm'];
    }

    function validDashboardPreferences(preferences) {
      return preferences == null || (
        preferences is map
        && preferences.keys().hasOnly([
          'autoOpenPipOnPageChange',
          'askObservationOnCancel',
          'showContractFieldOnCancel'
        ])
        && (!('autoOpenPipOnPageChange' in preferences) || preferences.autoOpenPipOnPageChange is bool)
        && (!('askObservationOnCancel' in preferences) || preferences.askObservationOnCancel is bool)
        && (!('showContractFieldOnCancel' in preferences) || preferences.showContractFieldOnCancel is bool)
      );
    }

    match /usuarios/{uid} {
      allow create: if isOwnUser(uid)
        && request.resource.data.keys().hasOnly([
          'uid',
          'matricula',
          'nome',
          'tag',
          'supervisor',
          'dashboardPreferences',
          'email',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.matricula is string
        && request.resource.data.nome is string
        && request.resource.data.email is string
        && request.resource.data.tag == 'cr'
        && request.resource.data.supervisor is string
        && request.resource.data.supervisor == ''
        && validDashboardPreferences(request.resource.data.dashboardPreferences);

      allow get: if isOwnUser(uid) || isAdmin();
      allow list: if isAdmin();

      allow update: if (
          isOwnUser(uid)
          && request.resource.data.keys().hasOnly([
            'uid',
            'matricula',
            'nome',
            'tag',
            'supervisor',
            'dashboardPreferences',
            'email',
            'createdAt',
            'updatedAt'
          ])
          && resource.data.uid == request.resource.data.uid
          && resource.data.matricula == request.resource.data.matricula
          && resource.data.nome == request.resource.data.nome
          && resource.data.email == request.resource.data.email
          && resource.data.createdAt == request.resource.data.createdAt
          && resource.data.tag == request.resource.data.tag
          && resource.data.supervisor == request.resource.data.supervisor
          && validDashboardPreferences(request.resource.data.dashboardPreferences)
        ) || (
          isAdmin()
          && request.resource.data.keys().hasOnly([
            'uid',
            'matricula',
            'nome',
            'tag',
            'supervisor',
            'dashboardPreferences',
            'email',
            'createdAt',
            'updatedAt'
          ])
          && resource.data.uid == request.resource.data.uid
          && resource.data.matricula == request.resource.data.matricula
          && resource.data.nome == request.resource.data.nome
          && resource.data.email == request.resource.data.email
          && resource.data.createdAt == request.resource.data.createdAt
          && request.resource.data.supervisor is string
          && validTag(request.resource.data.tag)
          && validDashboardPreferences(request.resource.data.dashboardPreferences)
        );

      allow delete: if false;
    }

    match /loginIndex/{matricula} {
      allow get: if true;
      allow list: if false;

      allow create: if currentUserExists()
        && request.resource.data.keys().hasOnly(['uid', 'matricula', 'email', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.matricula == matricula
        && request.resource.data.email == currentUserDoc().data.email;

      allow update, delete: if false;
    }

    match /registrosAtendimento/{registroId} {
      allow create: if currentUserExists()
        && request.resource.data.keys().hasOnly([
          'date',
          'time',
          'duration',
          'result',
          'reason',
          'contract',
          'observation',
          'timestamp',
          'operator',
          'operatorName',
          'supervisor',
          'cancelCountOfDay',
          'uid',
          'dayId',
          'whatsappSent'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.operator == currentUserDoc().data.matricula
        && request.resource.data.operatorName is string
        && request.resource.data.supervisor is string
        && request.resource.data.contract is string
        && request.resource.data.observation is string;

      allow read: if currentUserExists()
        && (resource.data.uid == request.auth.uid || isAdmin());

      allow update, delete: if false;
    }

    match /cancelamentoFila/{queueId} {
      allow create: if currentUserExists()
        && request.resource.data.keys().hasOnly([
          'uid',
          'operator',
          'operatorName',
          'supervisor',
          'cancelCountOfDay',
          'reason',
          'contract',
          'observation',
          'duration',
          'time',
          'dayId',
          'sourceTimestamp',
          'status',
          'attempts',
          'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.operator == currentUserDoc().data.matricula
        && request.resource.data.operatorName is string
        && request.resource.data.supervisor is string
        && request.resource.data.contract is string
        && request.resource.data.observation is string
        && request.resource.data.status == 'pending';

      allow read, delete: if isAdmin();
      allow update: if false;
    }

    match /demandasFila/{queueId} {
      allow create: if currentUserExists()
        && request.resource.data.keys().hasOnly([
          'uid',
          'operator',
          'operatorName',
          'supervisor',
          'demandType',
          'contract',
          'date',
          'startHour',
          'endHour',
          'area',
          'classe',
          'point',
          'suspensionItems',
          'message',
          'status',
          'attempts',
          'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.operator == currentUserDoc().data.matricula
        && request.resource.data.operatorName is string
        && request.resource.data.supervisor is string
        && request.resource.data.status == 'pending';

      allow read, delete: if isAdmin();
      allow update: if false;
    }

    match /configuracoesBot/{docId} {
      allow read, write: if isAdmin();
    }

    match /supervisorGrupos/{docId} {
      allow read, write: if isAdmin();
    }

    match /atendimentos/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
